# loadkeys es
# lsblk                                     (para ver discos)
# timedatectl set-ntp true                  (systemctl enable system-timesyncd.service)
# cfdisk /dev/vda                           (1ª: 512M efi, 2ª: 50G linux file system)
# lsblk   (para ver discos)
# cryptsetup luksFormat /dev/vda2
# cryptsetup luksOpen /dev/vda2 lvmcrypt
# pvcreate /dev/mapper/lvmcrypt             (crear volume fisico
# vgcreate vg0 /dev/mapper/lvmcrypt         (crear volume virtual llamado vg0)
Creamos particiones
# lvcreate -L 4G vg0 -n swap                (swap) 
# lvcreate -L 25G vg0 -n arch               (raiz)
# lvcreate -l 100%FREE vg0 -n home          (home)
# lvscan
Crear Sistema de archivos
# mkfs.vfat -n BOOT -F32 /dev/vda1
# mkfs.btrfs -L ROOT /dev/vg0/arch
# mkfs.ext4 -L HOME /dev/vg0/home
Activar intercambio
# mkswap /dev/vg0/swap
# swapon /dev/vg0/swap 
# lsblk -f
Creamos subvolumenes btrfs
# mount -t btrfs /dev/vg0/arch /mnt
# btrfs su cr /mnt/@                        (raiz)
# btrfs subvolume create /mnt/@home         (home)
# btrfs subvolume create /mnt/@var_log      (var/log)
# btrfs subvolume create /mnt/@snapshots    (snapshots)
# btrfs subvolume list -p /mnt              (buscar ID del @ subvolume)
# btrfs subvolume set-default               (pegamos ID) /   
# umount /mnt                               (desmontamos la partición) 
Creamos puntos de montaje y montamos nuestras particiones y subvolumenes
# mount /dev/vg0/arch -o subvol=@ /mnt     
(mount /dev/vg0/arch -o compress=zstd,noatime,space_cache=v2,subvol=@ /mnt)
# mkdir -p /mnt/{boot,home,var/log,.snapshots}    
(/mnt/boot /mnt/home /mnt/var/log /mnt/.snapshots)
# mount /dev/vg0/arch -o subvol=@home /mnt/home
# mount /dev/vg0/arch -o subvol=@var_log /mnt/var/log
# mount /dev/vg0/arch -o subvol=@snapshots /mnt/.snapshots
# mount -t vfat /dev/vda1 /mnt/boot
Instalacion del Sistema
# pacstrap /mnt base base-devel linux linux-firmware linux-headers btrfs-progs lvm2 efibootmgr networkmanager network-manager-applet amd-ucode  nano vim 
Generar archivo fstab
# genfstab -U /mnt >> /mnt/etc/fstab
# cat /mnt/etc/fstab                        (rw,relatime,compress=zstd,ssd,space_cache=v2,subvolid=256,subvol=/@,subvol=@) LABEL=ROOT
Chroot al nuevo sistema
# arch-chroot /mnt
Establecer zona horaria
# ln -sf /usr/share/zoneinfo/Europe/Madrid /etc/localtime
Generar locales
# nano -l /etc/locale.gen                   (descomentar es_ES.UTF-8)
# echo LANG=es_ES.UTF-8 > /etc/locale.conf
# export LANG=es_ES.UTF-8
# locale-gen
# hwclock –systohc            (-w)
# echo KEYMAP=es > /etc/vconsole.conf       (configura el teclado en español)
Establecer nombre del host
# echo “archlinux” > /etc/hostname
Configurar nuestra red local (rango)
# nano /etc/hosts
127.0.0.1    localhost
::1                 localhost
127.0.1.1     archlinux.localdomain   archlinux
Configuración del initramfs
# nano /etc/mkinitcpio.conf
HOOKS=(base udev autodetect modconf block encrypt lvm2 filesystems keyboard fsck)   
# mkinitcpio -P
Password, networkmanager, user
# systemctl enable NetworkManager.service   (activar el internet) 
# passwd                                    (establecer contraseña del root) 
# useradd -m -G wheel ruben
# passwd ruben
# EDITOR=nano visudo                        (nano -l /etc/sudoers) (%wheel ALL=(ALL) ALL)
# pacman -S amd-ucode                       (si el procesador es amd o intel-ucode) 
Instalación del cargador de arranque grub2
# pacman -S grub grub-btrfs efibootmgr os-prober mtools dosfstools e2fsprogs lvm2 inotify-tools timeshift 
# grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=arch -- removable 
# nano /etc/default/grub                    (descomentar: #GRUB_DISABLE_OS_PROBER=false)  
# grub-mkconfig -o /boot/grub/grub.cfg 
Salir del chroot y reiniciar
# exit
# umount -R /mnt
# swapoff -a
# reboot
# btrfs subvolume snapshot -r / /.snapshots/root-$(date +%Y%m%d) (creamos una instantanea del sistema base)
# nano /etc/pacman.conf        
# pacman -Syu
